#!/bin/bash
#PBS -N mpas_48h_x1.10242
#PBS -q pesqmini
#PBS -l select=1:ncpus=64:mpiprocs=64
#PBS -l walltime=00:30:00
#PBS -j oe

set -euo pipefail

# LEGACY diagnostic template. Production GFS/WPS/MPAS forecast generation is owned by mpaswf.
: "${BMATRIX_ROOT:?Set BMATRIX_ROOT to the MPAS-BMatrix repository checkout}"
: "${RUN_DIR:?Set RUN_DIR to the prepared legacy diagnostic runtime}"

source "${BMATRIX_ROOT}/scripts/load_jaci_env.sh"

cd "${RUN_DIR}"

export OMP_NUM_THREADS=1
export FI_CXI_RX_MATCH_MODE=hybrid
ulimit -s unlimited || true

echo "Job started at $(date -Is)"
echo "Host: $(hostname)"
echo "PBS_JOBID=${PBS_JOBID:-unknown}"
echo "RUN_DIR=${RUN_DIR}"
echo

module list || true

echo
echo "Running MPAS 48h test..."
mpiexec -n 64 ./mpas_atmosphere > stdout.log 2> stderr.log

echo
echo "MPAS finished at $(date -Is)"
echo

echo "Generated NetCDF files:"
ls -lh *.nc

echo
echo "Log tail:"
tail -120 log.atmosphere.0000.out || true

echo
echo "Error log:"
cat log.atmosphere.0000.err || true

echo
echo "stderr tail:"
tail -80 stderr.log || true
